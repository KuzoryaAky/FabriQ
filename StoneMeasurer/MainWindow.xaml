<Window x:Class="StoneMeasurer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="StoneMeasurer - Измерение камня" 
        Height="550" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Измерение параметров камня" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"
                   Grid.Row="0"/>

        <!-- Область для фото камня -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#CCCCCC" 
                BorderThickness="2" 
                CornerRadius="10"
                Margin="0,0,0,20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20">
                    <!-- Серый фон-плейсхолдер -->
                    <Border Background="#F0F0F0" 
                            BorderBrush="#CCCCCC" 
                            BorderThickness="1" 
                            CornerRadius="5"/>

                    <!-- Иконка-плейсхолдер -->
                    <TextBlock Text="📷" 
                               FontSize="48" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Foreground="#CCCCCC"/>

                    <!-- Текст под иконкой -->
                    <TextBlock Text="Загрузите фото камня" 
                               FontSize="16" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Bottom" 
                               Margin="0,0,0,20" 
                               Foreground="#999999"/>

                    <!-- Реальное изображение -->
                    <Image x:Name="StoneImage" 
                           Stretch="Uniform" 
                           Visibility="Collapsed"
                           Loaded="StoneImage_Loaded"/>

                    <!-- Canvas для рисования (поверх изображения) -->
                    <Canvas x:Name="DrawingCanvas" 
                            Visibility="Collapsed"
                            Background="Transparent"
                            MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="DrawingCanvas_MouseLeftButtonUp"
                            MouseMove="DrawingCanvas_MouseMove"
                            MouseLeave="DrawingCanvas_MouseLeave"/>
                </Grid>

                <!-- Информация об измерениях камня с кнопками управления -->
                <Border Grid.Row="1" 
                        Background="#F5F5F5" 
                        CornerRadius="0,0,10,10"
                        Padding="10">
                    <StackPanel>

                        <!-- Панель для калибровки эталона -->
                        <!-- Панель для калибровки эталона (только прямоугольник) -->
                        <Border x:Name="EtalonPanel" 
                                Background="#E8E8E8" 
                                CornerRadius="5" 
                                Padding="10"
                                Margin="0,5,0,5"
                                Visibility="Visible">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовок -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" 
                                           Text="КАЛИБРОВКА ПО ПРЯМОУГОЛЬНИКУ"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>

                                <!-- Ширина эталона -->
                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                           Text="Ширина:" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,5"/>

                                <TextBox x:Name="EtalonHeightInput" 
                                         Grid.Row="1" 
                                         Text="10" 
                                         Margin="53,0,240,5" 
                                         Padding="5" Grid.ColumnSpan="2"/>

                                <TextBlock Grid.Row="1" Grid.Column="1" 
                                           Text="мм" 
                                           VerticalAlignment="Top"
                                           Margin="97,6,204,0"/>

                                <!-- Высота эталона -->
                                <TextBlock Grid.Row="1" Grid.Column="3" 
                                           Text="Высота:" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,5"/>

                                <TextBox x:Name="EtalonWidthInput" 
                                         Grid.Row="1" Grid.Column="3" 
                                         Text="10" 
                                         Margin="51,0,191,5" 
                                         Padding="5"/>

                                <TextBlock Grid.Row="1" Grid.Column="3" 
                                           Text="мм" 
                                           VerticalAlignment="Top"
                                           Margin="145,6,139,0"/>

                               

                                <!-- Информация о выделении -->
                                <TextBlock x:Name="EtalonSelectionInfo" 
                                           Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                                           Text="Выделите прямоугольник (4 точки по углам)"
                                           Foreground="#666666"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>


                                <!-- Кнопка применения -->
                                <Button x:Name="ApplyEtalonButton" 
                                        Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" 
                                        Content="ПРИМЕНИТЬ КАЛИБРОВКУ" 
                                        Click="ApplyEtalonButton_Click"
                                        Background="#4CAF50"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="8"
                                        Margin="0,5,0,0"
                                        FontWeight="Bold"
                                        Height="35"/>
                            </Grid>
                        </Border>

                        <!-- Информация о режиме -->
                        <TextBlock x:Name="ModeInfoText" 
                                   Text="Режим: ожидание загрузки фото" 
                                   Foreground="#666666"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <!-- Информация об измерениях -->
                        <TextBlock x:Name="MeasurementInfoText" 
                                   Text="Результаты измерений будут здесь" 
                                   Foreground="#666666"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <!-- Панель выбора режима -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    Margin="0,5,0,5">

                            <RadioButton x:Name="ModeStone" 
                                         Content="Измерение камня" 
                                         GroupName="ModeGroup"
                                         IsChecked="True"
                                         Margin="0,0,15,0"
                                         Checked="Mode_Changed"/>

                            <RadioButton x:Name="ModeEtalon" 
                                         Content="Калибровка эталона" 
                                         GroupName="ModeGroup"
                                         Checked="Mode_Changed"/>
                        </StackPanel>



                        <!-- Панель управления выделением -->
                        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0">

                            <Button x:Name="StartSelectionButton" 
                                    Content="Начать выделение" 
                                    Click="StartSelectionButton_Click"
                                    Margin="0,0,5,0"
                                    Padding="8,4"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="12">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button x:Name="AutoDetect" 
                                    Content="Авто-детекция контура" 
                                    Click="AutoDetect_Click"
                                    Margin="5,0,5,0"
                                    Padding="8,4"
                                    Background="#FF5722"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="12">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            
                            
                            <Button x:Name="ClearSelectionButton" 
                                    Content="Очистить" 
                                    Click="ClearSelectionButton_Click"
                                    Margin="5,0,5,0"
                                    Padding="8,4"
                                    Background="#FF5722"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="12"
                                    IsEnabled="False">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button x:Name="CompleteSelectionButton" 
                                    Content="Завершить" 
                                    Click="CompleteSelectionButton_Click"
                                    Margin="5,0,0,0"
                                    Padding="8,4"
                                    Background="#2196F3"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="12"
                                    IsEnabled="False">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- Информация о выделении и масштабе -->
                        <TextBlock x:Name="SelectionInfoText" 
                                   Text=""
                                   Foreground="#666666"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"
                                   FontSize="11"/>

                        <TextBlock x:Name="ScaleInfoText" 
                                   Text=""
                                   Foreground="#0066CC"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"
                                   FontSize="11"
                                   Visibility="Collapsed"/>

                        <!-- Добавьте после ScaleInfoText в нижней панели -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    Margin="0,5,0,0"
                                    Visibility="Visible"
                                    x:Name="ScaleAdjustPanel">

                            <TextBlock Text="Корректировка масштаба:" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,5,0"
                                       FontSize="10"/>

                            <TextBlock x:Name="ScaleFactorText" 
                                       Text="1.00x" 
                                       VerticalAlignment="Center" 
                                       Margin="5,0,0,0"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                            
                            <Slider x:Name="ScaleSlider" 
                                    Width="150" 
                                    Minimum="0.5" 
                                    Maximum="2.0" 
                                    Value="1.0" 
                                    SmallChange="0.01" 
                                    LargeChange="0.1"
                                    ValueChanged="ScaleSlider_ValueChanged"
                                    VerticalAlignment="Center"/>

                            
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Панель с кнопками -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Margin="0,10">

            <!-- Кнопка 1: Загрузить фото камня -->
            <Button x:Name="LoadStoneButton" 
                    Content="📷 Загрузить камень" 
                    Width="180" 
                    Height="45"
                    Margin="0,0,15,0"
                    Background="#8B4513"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="LoadStoneButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Кнопка 2: Измерить камень -->
            <Button x:Name="MeasureButton" 
                    Content="📏 Измерить" 
                    Width="180" 
                    Height="45"
                    Margin="0,0,15,0"
                    Background="#2E7D32"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsEnabled="False"
                    Click="MeasureButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Кнопка 3: Экспорт результатов -->
            <Button x:Name="ExportButton" 
                    Content="📊 Экспорт данных" 
                    Width="180" 
                    Height="45"
                    Background="#1565C0"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsEnabled="False"
                    Click="ExportButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>